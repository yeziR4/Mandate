# Keeper image. Build from the repo root:
#   docker build -f Dockerfile.keeper -t mandate-keeper .
#
# The keeper imports the referee module from mandate/, so the build context is the repo,
# not keeper/. Only production dependencies are installed.
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY keeper ./keeper
COPY lib/loadEnv.ts ./lib/loadEnv.ts
COPY mandate/referee.ts mandate/policy.txt mandate/models.json ./mandate/

# transcripts live here; mount a volume so a restart does not lose the record
RUN mkdir -p /app/data && chown -R node:node /app/data
ENV DATA_DIR=/app/data
VOLUME ["/app/data"]
EXPOSE 8787
USER node
CMD ["node", "--experimental-strip-types", "keeper/server.ts"]
